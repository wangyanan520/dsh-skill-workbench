{
  "name": "dsh-skill-workbench",
  "version": "0.4.1",
  "type": "module",
  "description": "DSH 技能中文显示层：/ 菜单按中文分类显示中文名与简介，调用仍是英文 /name；中文数据旁路存储，不改 SKILL.md；支持从安装来源补简介与卸载回收站。",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyanan520/dsh-skill-workbench.git"
  },
  "homepage": "https://github.com/wangyanan520/dsh-skill-workbench#readme",
  "bugs": {
    "url": "https://github.com/wangyanan520/dsh-skill-workbench/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "!host/selftest.mjs",
    "cordis.patch.yml",
    "locale/",
    "translations/",
    "docs/",
    "assets/icon.svg",
    "assets/icon-180.png",
    "README.md"
  ],
  "scripts": {
    "selftest": "node client.selftest.mjs && node host/selftest.mjs && node translations/validate.mjs",
    "audit:zh": "node scripts/audit-zh.mjs",
    "audit:zh:strict": "node scripts/audit-zh.mjs --strict",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:page": "node test/page-regression-test.mjs && node test/write-path-test.mjs",
    "live-test": "node test/run-live.mjs",
    "prepare": "husky",
    "audit:zh:ci": "node scripts/audit-zh.mjs --builtin-only --require-data",
    "audit:zh:selftest": "node scripts/audit-zh.mjs --self-test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skill-manager",
    "display-name",
    "i18n",
    "chinese"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
