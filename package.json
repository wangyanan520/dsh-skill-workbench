{
  "name": "dsh-skill-workbench",
  "version": "0.3.0",
  "type": "module",
  "description": "DSH 技能管理：给技能加一层中文显示中间层，/ 菜单按中文分类显示中文显示名与简介（调用 token 仍是英文 /name）；管理页支持改名、编辑简介/分类、查看覆盖率，绝不修改任何 SKILL.md。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyanan520/dsh-skill-workbench.git"
  },
  "homepage": "https://github.com/wangyanan520/dsh-skill-workbench#readme",
  "bugs": {
    "url": "https://github.com/wangyanan520/dsh-skill-workbench/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "cordis.patch.yml",
    "locale/",
    "translations/",
    "docs/",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "selftest": "node client.selftest.mjs && node host/selftest.mjs && node translations/validate.mjs",
    "live-test": "node test/run-live.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skill-manager",
    "display-name",
    "i18n",
    "chinese"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
