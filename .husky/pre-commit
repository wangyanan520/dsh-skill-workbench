#!/usr/bin/env sh
# 提交前门禁（全绿约 5 秒）。只跑不依赖本机技能数据的检查，避免因环境漂移挡住正常提交。
# audit:zh 需要磁盘 SKILL.md 原文，因此留给 CI 的 --builtin-only 与 PR 自查清单。
# 临时绕过：git commit --no-verify
set -e

echo "[pre-commit] 语法检查"
node --check client.js

echo "[pre-commit] 客户端自测"
node client.selftest.mjs

echo "[pre-commit] 主题对比度"
node scripts/check-contrast.mjs

echo "[pre-commit] 宿主自测（跳过本机技能目录扫描）"
SKIP_REAL_AGENTS_SCAN=1 node host/selftest.mjs

# 页面回归是唯一能抓「控件永不渲染」这类死代码的测试（R1 的教训）。
# 它需要 devDependencies；新克隆没跑 npm i 时降级跳过，不阻断提交。
if [ -d node_modules/react-test-renderer ]; then
  echo "[pre-commit] 管理页离线回归"
  node test/page-regression-test.mjs
else
  echo "[pre-commit] 跳过管理页回归：未安装 devDependencies（npm i 后自动启用）"
fi
